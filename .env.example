PORT=3000
# En Railway será /data/uploads, el punto de montaje del Volume.
UPLOAD_DIR=./uploads
# Dominio público del backend, sin slash final.
PUBLIC_API_URL=http://localhost:3000
# URL del frontend Ionic separadas por coma.
CORS_ORIGIN=http://localhost:8100
# JSON completo de la service account de Firebase en una sola línea.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account"}
